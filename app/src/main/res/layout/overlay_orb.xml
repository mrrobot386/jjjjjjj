<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="160dp"
    android:layout_height="160dp"
    android:background="@drawable/bg_overlay_orb"
    android:padding="8dp">

    <com.myra.assistant.ui.main.OrbAnimationView
        android:id="@+id/overlayOrbView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/overlayLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="#99000000"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.1"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="MYRA"
        android:textColor="#FF1744"
        android:textSize="11sp" />

    <ImageButton
        android:id="@+id/overlayCloseBtn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close Overlay"
        android:src="@drawable/ic_close" />
</FrameLayout>
